# Caddyfile for ytdlbot
# Caddy automatically handles HTTPS/SSL certificates via Let's Encrypt

# Production: Replace 'your-domain.com' with your actual domain
# Caddy will automatically get SSL certificates
your-domain.com {
    reverse_proxy ytdl:8000
    
    # Optional: Security headers
    header {
        # Enable HSTS
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Prevent clickjacking
        X-Frame-Options "SAMEORIGIN"
        # XSS protection
        X-Content-Type-Options "nosniff"
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# Development: HTTP only (no domain needed)
# Uncomment this if you don't have a domain yet
